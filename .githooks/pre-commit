#!/usr/bin/env bash
# In-repo pre-commit entry. Prefer the pre-commit runner so named hooks
# match .pre-commit-config.yaml; fall back to the same Makefile targets.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
export PATH="${HOME}/.local/bin:${HOME}/.opam/5.3.0/bin:${HOME}/.local/share/mise/installs/gitleaks/8.30.1:${HOME}/.local/opt/fstar/bin:${PATH}"
if command -v opam >/dev/null 2>&1; then
  eval "$(opam env --switch=5.3.0 2>/dev/null || opam env || true)"
fi
if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --hook-stage pre-commit --all-files
fi
make test
make sast
make vuln
make secrets
make fmt-check
